{
    "name": "hoteler-web",
    "version": "0.0.7",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "ng": "ng",
        "tauri": "tauri",
        "start": "ng serve",
        "start:online": "npm run ng serve -- --proxy-config=src/proxy.conf.online.json --hmr",
        "build": "ng build",
        "changelog": "conventional-changelog -p angular -i CHANGELOG.md -o CHANGELOG.md",
        "changelog:all": "conventional-changelog -p angular -r 0 -o CHANGELOG.md",
        "test": "ng test",
        "test:ci": "ng test --watch=false --coverage",
        "lint": "npm run lint:ts && npm run lint:scss",
        "lint:ts": "ng lint",
        "lint:scss": "stylelint \"src/**/*.scss\"",
        "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix",
        "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
        "version:patch": "npm version patch -m \"chore(release): v%s\"",
        "version:minor": "npm version minor -m \"chore(release): v%s\"",
        "prepare": "is-ci || husky",
        "analyze": "ng build --configuration production --stats-json",
        "e2e": "ng e2e",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "22.3.0",
        "@angular/cdk": "22.3.0",
        "@angular/common": "22.3.0",
        "@angular/compiler": "22.3.0",
        "@angular/core": "22.3.0",
        "@angular/forms": "22.3.0",
        "@angular/material": "22.3.0",
        "@angular/platform-browser": "22.3.0",
        "@angular/platform-browser-dynamic": "22.3.0",
        "@angular/router": "22.3.0",
        "@ngneat/overview": "^8.1.0",
        "@ngxpert/hot-toast": "7.0.0",
        "apexcharts": "8.9.1",
        "ngx-apexcharts": "1.2.0",
        "ngx-avatars": "^1.9.3",
        "ngx-dom-confetti": "^0.8.0",
        "ngx-is-standalone": "0.3.0",
        "perf-marks": "^1.14.2",
        "rxjs": "7.8.2",
        "tfontfaceobserver": "^0.0.2",
        "tslib": "2.9.1",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.2.2",
        "@angular/cli": "22.3.0",
        "@angular/compiler-cli": "22.3.0",
        "@angular/language-service": "22.3.0",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@cypress/schematic": "6.0.0",
        "@tauri-apps/cli": "^1.6.0",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "^4.1.11",
        "angular-eslint": "22.8.0",
        "autoprefixer": "^10.4.20",
        "baseline-browser-mapping": "^2.10.14",
        "conventional-changelog": "^8.1.3",
        "conventional-changelog-angular": "^9.4.0",
        "cypress": "latest",
        "dotenv": "^18.0.0",
        "eslint": "^9.28.0",
        "happy-dom": "^21.0.0",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.6.2",
        "postcss": "^8.4.45",
        "postcss-scss": "^4.0.6",
        "prettier": "3.10.1",
        "stylelint": "^16.1.0",
        "stylelint-config-recommended-scss": "^14.0.0",
        "stylelint-config-standard": "^36.0.0",
        "stylelint-config-standard-scss": "^13.0.0",
        "stylelint-scss": "^7.5.0",
        "tailwindcss": "^3.4.11",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.33.1",
        "vitest": "^4.0.8"
    }
}
